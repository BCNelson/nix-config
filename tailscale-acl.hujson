// This tailnet's ACLs are maintained in https://github.com/BCNelson/nix-config

// Example/default ACLs for unrestricted connections.
{
	// Declare static groups of users beyond those in the identity service.
	"groups": {
		"group:admin": ["bradleynelson102@gmail.com"],
		"group:nelsonFamily": [
			"bradleynelson102@gmail.com",
			"cknelson8@gmail.com",
			"cwnelson1990@gmail.com"
		],
		"group:gaming": [
			"brennonschow@gmail.com",
			"nelson.7.jeffery@gmail.com"
		],
		"group:familyVPN": ["Clements.Josiah10@gmail.com"],
		// bwnelson's sandbox container on romeo (nixos/romeo/containers/bwnelson.nix)
		"group:brother": ["bnels65@gmail.com"]
	},

	// Declare convenient hostname aliases to use in place of IP addresses.
	"hosts": {
		"vor": "100.73.83.164",
		"vor6": "fd7a:115c:a1e0:ab12:4843:cd96:6249:53a4",
		"romeo": "100.76.49.168",
		"romeo6": "fd7a:115c:a1e0:ab12:4843:cd96:624c:31a8",
		"xray": "100.114.232.151",
		"porter-pc": "100.111.54.18",
		"sierra": "100.92.32.99",
		"whiskey": "100.89.15.100",
		"whiskey6": "fd7a:115c:a1e0::ad01:f64"
	},

	"tagOwners": {
		"tag:server":  ["bradleynelson102@gmail.com"],
		"tag:client":  ["bradleynelson102@gmail.com"],
		"tag:iso":     ["bradleynelson102@gmail.com"],
		"tag:guest":   ["bradleynelson102@gmail.com"]
	},

	// Access control lists.
	"acls": [
		// Match absolutely everything.
		// Comment this section out if you want to define specific restrictions.
		{"action": "accept", "src": ["group:admin"], "dst": ["*:*"]},
		// Allow Outgoing syncthing connections
		{"action": "accept", "src": ["romeo", "romeo6"], "dst": ["*:22000"]},
		// Allow to vor for smb
		{"action": "accept", "src": ["group:nelsonFamily"], "dst": ["vor:445"]},
		{"action": "accept", "src": ["romeo", "romeo6"], "dst": ["tag:server:22"]},
		{"action": "accept", "src": ["autogroup:member"], "dst": ["autogroup:self:22"]},
		{"action": "accept", "src": ["group:gaming"], "dst": ["sierra:52450"]},
		// Prometheus node exporter
		{"action": "accept", "src": ["whiskey", "whiskey6"], "dst": ["tag:server:9100"]},
		// whiskey offloads its nix builds to romeo (nixos/whiskey/remote-builds.nix).
		// Port 22 on romeo's tailnet address is Tailscale SSH, so this is the
		// network half of a grant the ssh section below already makes for
		// tag:server -> tag:server. Only romeo: no other server builds for it.
		{"action": "accept", "src": ["whiskey", "whiskey6"], "dst": ["romeo:22", "romeo6:22"]},
		//Loki
		{"action": "accept", "src": ["tag:server"], "dst": ["whiskey:3100", "whiskey6:3100"]},
		// bwnelson reaches his own sandbox on every port -- it is his box, and
		// this way a web service he builds is reachable without an ACL change.
		// Nothing grants him anything else on the tailnet; default-deny covers
		// the rest.
		{"action": "accept", "src": ["group:brother"], "dst": ["tag:guest:*"]}
	],
	// Josiah's family VPN, routed out through vor. Committed 2026-01-21 and never
	// once applied: every run of the ACL sync since has failed on a dead
	// TS_API_KEY, so the live policy predates it. With the key fixed, the policy
	// compiler rejects this grant for two reasons -- a grant needs `ip` (or
	// `app`), which this has neither of, and `via` accepts only tags, not the
	// host aliases used here -- and one bad grant fails the whole document,
	// including everything below it.
	//
	// Parked rather than guessed at, because making it work is an access
	// decision: either familyVPN may exit via any tag:server node (vor and the
	// Home Assistant box both offer exit routing), or vor gets a tag of its own
	// so `via` can name it. Removing it changes nothing operationally -- it has
	// never been live.
	"grants": [
		// {
		// 	"src": ["group:familyVPN"],
		// 	"dst": ["autogroup:internet"],
		// 	"via": ["vor", "vor6"],
		// 	"ip":  ["*"]          // required, and `via` still needs to be a tag
		// }
	],
	"ssh": [
		{
			"action": "accept",
			"src":    ["group:admin"],
			"dst":    ["tag:server"],
			"users":  ["autogroup:nonroot", "root"]
		},
		{
			"action": "accept",
			"src":    ["group:admin"],
			"dst":    ["tag:client"],
			"users":  ["autogroup:nonroot", "root"]
		},
		{ // any user can use Tailscale SSH to connect to their own devices
			// in check mode as a root or non-root user
			"action": "check",
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"users": ["autogroup:nonroot"]
		},
		{ // Server-to-server SSH is two machine-to-machine jobs and nothing else:
			// syncoid replicating romeo -> vor (nixos/romeo/backups.nix) and nix
			// remote builds whiskey -> romeo (docs/remote-builds.md). Hence an
			// explicit allowlist. "autogroup:nonroot" was not the lesser grant it
			// reads as -- it admits bcnelson, who is in @wheel with passwordless
			// sudo on every server, so non-root meant root by a second hop.
			//
			// A person SSHing between two tagged servers is attributed to
			// tag:server, not to themselves, so this deliberately ends those hops.
			// Reach each host directly instead; group:admin above still grants
			// root and non-root on every one of them.
			"action": "accept",
			"src":    ["tag:server"],
			"dst":    ["tag:server"],
			"users":  ["syncoid", "nixremote"]
		},
		{ // Tailscale SSH is how bwnelson gets in -- his tailnet identity is the
			// credential, so he needs no key on file. "accept" rather than "check"
			// so he is not re-authenticating in a browser every session. He is not
			// granted root over SSH; he sudos inside his own container instead.
			"action": "accept",
			"src":    ["group:brother"],
			"dst":    ["tag:guest"],
			"users":  ["bwnelson"]
		}
	],
	"tests": [
		{
			"src": "bradleynelson102@gmail.com",
			"accept": ["tag:server:22"]
		},
		// bwnelson reaches his sandbox and nothing else.
		{
			"src": "group:brother",
			"accept": ["tag:guest:22"],
			"deny": ["romeo:22", "vor:22", "whiskey:22", "tag:server:22"]
		},
		{
			"src": "group:nelsonFamily",
			"accept": ["vor:445"],
			"deny": ["vor:22"]
		},
		//Romeo should be able to access vor:22 for backup replication
		{
			"src": "romeo",
			"accept": ["vor:22"],
			"deny": ["xray:22", "porter-pc:22"]
		},
		// Whiskey should be able to access romeo:9002 for prometheus node exporter
		{
			"src": "whiskey",
			"accept": ["romeo:9100", "vor:9100", "tag:server:9100"],
			"deny": ["xray:22", "porter-pc:22"]
		},
		// Whiskey builds on romeo over Tailscale SSH, and only on romeo.
		{
			"src": "whiskey",
			"accept": ["romeo:22"],
			"deny": ["vor:22"]
		},
		// Romeo should not be able to access node_exporter on whiskey
		{
			"src": "romeo",
			"deny": ["whiskey:9100"]
		},
		{
			"src": "tag:server",
			"accept": ["whiskey:3100", "whiskey6:3100"]
		}
	],
	"sshTests": [
		{
			"src": "bradleynelson102@gmail.com",
			"dst": ["tag:server"],
			"accept": ["autogroup:nonroot", "root"]
		},
		// The two machine accounts, and nothing that reaches a root shell:
		// nixremote builds (nixos/romeo/remote-builder.nix), syncoid replicates
		// (nixos/romeo/backups.nix), and bcnelson is denied because @wheel plus
		// passwordless sudo would make landing as them equivalent to root.
		{
			"src": "tag:server",
			"dst": ["tag:server"],
			"accept": ["nixremote", "syncoid"],
			"deny": ["root", "bcnelson"]
		}
	]
}

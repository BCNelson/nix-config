 void PlasmaScreencastV1Session::sendEvent(const std::shared_ptr<QEvent> &event)
 {
     if (isStarted() && d->eiConnection) {
+        // The client points in stream pixels; when the desktop is captured
+        // scaled down, map back to logical desktop coordinates.
+        if (d->workspaceScale != 1.0 && event->type() == QEvent::MouseMove) {
+            const auto me = std::static_pointer_cast<QMouseEvent>(event);
+            const QPointF logical = me->position() / d->workspaceScale;
+            auto scaled = std::make_shared<QMouseEvent>(me->type(), logical, logical, me->button(), me->buttons(), me->modifiers());
+            d->eiConnection->sendEvent(scaled, size(), {});
+            return;
+        }
         d->eiConnection->sendEvent(event, size(), {});
     }

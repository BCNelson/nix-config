+// The whole desktop as one region stream. Unlike KWin's workspace stream this
+// is called with an explicit rectangle, which is used to fix two problems:
+//
+//  - With fractional scaling the logical screen sizes are rounded (two 2560px
+//    outputs at 1.3 come out 1969 wide, the second at x=1970), so the union
+//    can have an odd width. RDP clients round their desktop down to an even
+//    size, and a surface wider than that makes them drop the graphics
+//    channel. The rectangle is trimmed to even (at most one pixel is lost).
+//
+//  - Two monitors side by side are too wide for some clients' decoders
+//    (aRDP decodes H.264 in software and silently never acknowledges a
+//    3938px-wide frame). KRDP_WORKSPACE_MAX_WIDTH caps the stream width by
+//    capturing at a scale below 1. Unset, the stream is at scale 1 as before.
+static ScreencastingStream *createScaledWorkspaceStream(Screencasting &screencasting, qreal *scaleOut)
+{
+    const auto screens = qGuiApp->screens();
+    if (screens.size() == 1) {
+        return screencasting.createOutputStream(screens.first(), Screencasting::Metadata);
+    }
+
+    QRect workspace;
+    for (QScreen *screen : screens) {
+        workspace |= screen->geometry();
+    }
+    workspace.setWidth(workspace.width() & ~1);
+    workspace.setHeight(workspace.height() & ~1);
+
+    qreal scale = 1.0;
+    bool ok = false;
+    const int maxWidth = qEnvironmentVariableIntValue("KRDP_WORKSPACE_MAX_WIDTH", &ok);
+    if (ok && maxWidth > 0 && workspace.width() > maxWidth) {
+        // An even target width, so the stream comes out even too.
+        scale = qreal(maxWidth & ~1) / workspace.width();
+    }
+    qCDebug(KRDP) << "Whole-desktop stream" << workspace << "at scale" << scale;
+
+    *scaleOut = scale;
+    return screencasting.createRegionStream(workspace, scale, Screencasting::Metadata);
+}

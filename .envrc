# The dev shell puts nixcfg on PATH (status line, guard hook, MCP server).
# nix-direnv only rebuilds its cached shell when flake.nix/flake.lock change,
# so without this a nixcfg change keeps running the old binary until a
# manual `direnv reload`. Must come before `use flake`.
watch_file $(find pkgs/nixcfg-mcp -name '*.go' -o -name go.mod -o -name go.sum -o -name default.nix)
use flake .
